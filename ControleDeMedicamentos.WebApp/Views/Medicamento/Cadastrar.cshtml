@model CadastrarMedicamentoViewModel

@{
    ViewBag.Titulo = "Cadastro de Medicamento";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
</div>

<div class="col-lg-5 col-xl-4 needs-validation">
    <form class="container-fluid mt-3" asp-action="Cadastrar" method="post">
        <div class="mb-3">
            <label class="form-label" asp-for="Nome">Nome:</label>
            <input class="form-control" asp-for="Nome" id="Nome" type="text" placeholder="Nome do medicamento" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Descricao">Descrição:</label>
            <input class="form-control" asp-for="Descricao" id="Descricao" type="text" placeholder="Descrição do medicamento" />
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="QtdEstoque">Quantidade em Estoque:</label>
            <input class="form-control" asp-for="QtdEstoque" id="QtdEstoque" type="number" value="" placeholder="Qtd. em Estoque" />
            <span asp-validation-for="QtdEstoque" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="FornecedorID">Fornecedor:</label>
            <select class="form-select" asp-for="FornecedorID" asp-items="@Model.FornecedoresDisponiveis" id="FornecedorID"></select> 
            <span asp-validation-for="FornecedorID" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a class="btn btn-secondary" asp-action="Index">Voltar</a>
            <button class="btn btn-success" type="submit">Salvar</button>
        </div>
    </form>
</div>