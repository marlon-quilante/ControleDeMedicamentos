@model SaidaMedicamentoViewModel

@{
    ViewBag.Titulo = "Saída de Medicamento";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
</div>

<div class="col-lg-5 col-xl-4">
    <div class="container-fluid mt-3">
        <h4>Medicamento: <strong>@Model.Nome</strong></h4>
        <p>Estoque Atual: <strong>@Model.QtdEstoque</strong></p>
    </div>
    <form class="container-fluid mt-3" asp-action="SaidaMedicamento" asp-route-id="@Model.Id" method="post">
        <div class="mb-3">
            <label class="form-label" asp-for="QtdSaida">Quantidade de Saída:</label>
            <input class="form-control" asp-for="QtdSaida" id="QtdSaida" type="number" value="" placeholder="Qtd. de Saída" />
            <span asp-validation-for="QtdSaida" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-secondary" asp-action="Index">Voltar</a>
            <button class="btn btn-success" type="submit">Confirmar</button>
        </div>
    </form>
</div>