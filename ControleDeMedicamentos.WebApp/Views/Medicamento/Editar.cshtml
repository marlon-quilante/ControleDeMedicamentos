@model EditarMedicamentoViewModel

@{
    ViewBag.Titulo = "Edição de Medicamento";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
</div>

<div class="d-flex justify-content-center">
    <div class="col-sm-8 col-lg-6 needs-validation">
        <form class="container-fluid mt-3" asp-action="Editar" method="post">
            <div class="mb-3">
                <label class="form-label" asp-for="Nome">Nome:</label>
                <input class="form-control" asp-for="Nome" id="Nome" type="text" value="@Model.Nome" placeholder="Nome do medicamento" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Descricao">Descrição:</label>
                <input class="form-control" asp-for="Descricao" id="Descricao" type="text" value="@Model.Descricao" placeholder="Descrição do medicamento" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="FornecedorID">Fornecedor:</label>
                <select class="form-select" asp-for="FornecedorID" id="FornecedorID" asp-items="@Model.FornecedoresDisponiveis" id="FornecedorID"></select>
                <span asp-validation-for="FornecedorID" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a class="btn btn-secondary" asp-action="Index">Voltar</a>
                <button class="btn btn-success" type="submit">Salvar</button>
            </div>
        </form>
    </div>
</div>