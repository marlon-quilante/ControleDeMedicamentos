@model VisualizarFuncionariosViewModel

@{
    ViewBag.Titulo = "Funcionários";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
    <a class="btn btn-close-white ms-auto mt-2 mb-2" href="/Funcionario/Cadastrar">
        <i class="bi bi-plus"></i>
        Cadastrar
    </a>
</div>

<div class="container-fluid">
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nome</th>
                <th scope="col">CPF</th>
                <th scope="col">Telefone</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DetalhesFuncionarioViewModel f in Model.Funcionarios)
            {
                <tr>
                    <td scope="row">@f.Id</td>
                    <td scope="row">@f.Nome</td>
                    <td scope="row">@f.CPF</td>
                    <td scope="row">@f.Telefone</td>
                </tr>
            }
        </tbody>
    </table>
</div>