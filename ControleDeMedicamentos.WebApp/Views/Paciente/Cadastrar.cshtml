@model CadastrarPacienteViewModel

@{
    ViewBag.Titulo = "Cadastro de Paciente";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
</div>

<div class="d-flex justify-content-center">
    <div class="col-sm-8 col-lg-6 needs-validation">
        <form class="container-fluid mt-3" asp-action="Cadastrar" method="post">
            <div class="mb-3">
                <label class="form-label" asp-for="Nome">Nome:</label>
                <input class="form-control" asp-for="Nome" id="Nome" type="text" placeholder="Nome do paciente" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Telefone">Telefone:</label>
                <input class="form-control" asp-for="Telefone" id="Telefone" type="text" placeholder="(99) 99999-9999" />
                <span asp-validation-for="Telefone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="CPF">CPF:</label>
                <input class="form-control" asp-for="CPF" id="CPF" type="text" placeholder="999.999.999-99" />
                <span asp-validation-for="CPF" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="NumCartaoSUS">Nº do Cartão SUS:</label>
                <input class="form-control" asp-for="NumCartaoSUS" id="NumCartaoSUS" type="number" placeholder="999999999999999" />
                <span asp-validation-for="NumCartaoSUS" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a class="btn btn-secondary" asp-action="Index">Voltar</a>
                <button class="btn btn-success" type="submit">Salvar</button>
            </div>
        </form>
    </div>
</div>