@model ExcluirPacienteViewModel

@{
    ViewBag.Titulo = "Exclusão de Paciente";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
</div>

<div class="container-fluid">
    <form asp-action="ExcluirConfirmado" asp-route-id="@Model.Id" method="post">
        <p>Deseja realmente excluir o paciente <strong>@Model.Nome</strong></p>
        <div class="d-flex gap-2">
            <a class="btn btn-secondary" asp-action="Index">Voltar</a>
            <button class="btn btn-danger" type="submit">Excluir</button>
        </div>
    </form>
</div>