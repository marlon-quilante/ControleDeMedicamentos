@model VisualizarEntradasSaidasMedicamentoViewModel

@{
    ViewBag.Titulo = "Entradas e Saídas de Medicamentos";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
    <div class="d-flex ms-auto">
        <a class="btn btn-outline-light mt-2 mb-2 me-2" asp-action="RegistrarEntrada">
            Entrada
        </a>
        <a class="btn btn-outline-light mt-2 mb-2" asp-action="RegistrarSaida">
            Saída
        </a>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-5 col-xl-6">
            <h1>Entradas</h1>
            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th>Medicamento</th>
                        <th>Quantidade</th>
                        <th>Registrado Por</th>
                        <th>Data da Entrada</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DetalhesEntradaMedicamentoViewModel e in Model.EntradasMedicamento)
                    {
                        <tr>
                            <td>@e.Medicamento.Nome</td>
                            <td>@e.QtdEntrada</td>
                            <td>@e.Funcionario.Nome</td>
                            <td>@e.DataEntrada.ToString("G")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-lg-5 col-xl-6">
            <h1>Saídas</h1>
            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th>Medicamento</th>
                        <th>Quantidade</th>
                        <th>Paciente</th>
                        <th>Registrado Por</th>
                        <th>Data da Saída</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DetalhesSaidaMedicamentoViewModel s in Model.SaidasMedicamento)
                    {
                        foreach (DetalhesMedicamentoPrescritoSaidaMedicamentoViewModel m in s.MedicamentosPrescritos)
                        {
                            <tr>
                                <td>@m.NomeMedicamento</td>
                                <td>@m.Quantidade</td>
                                <td>@s.NomePaciente</td>
                                <td>@s.NomeFuncionario</td>
                                <td>@s.DataSaida.ToString("G")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>