@model DadosIniciaisSaidaMedicamentoViewModel

@{
    ViewBag.Titulo = "Registro de Saída de Medicamento";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
</div>

<div class="d-flex justify-content-center">
    <div class="col-sm-8 col-lg-6 needs-validation">
        <form class="container-fluid mt-3" asp-action="RegistrarSaida" method="post">
            <div class="mb-3">
                <label class="form-label" asp-for="FuncionarioID">Funcionário:</label>
                <select class="form-select" name="FuncionarioID" asp-for="FuncionarioID" id="PacienteID" asp-items="@Model.FuncionariosDisponiveis"></select>
                <span asp-validation-for="FuncionarioID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="CPFPaciente">CPF do paciente:</label>
                <input class="form-control" asp-for="CPFPaciente" id="CPFPaciente" type="text" placeholder="999.999.999-99" />
                <span asp-validation-for="CPFPaciente" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a class="btn btn-secondary" asp-action="Index">Voltar</a>
                <button class="btn btn-success" type="submit">Continuar</button>
            </div>
        </form>
    </div>
</div>