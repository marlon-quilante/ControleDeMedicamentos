@model RegistrarSaidaMedicamentoViewModel

@{
    ViewBag.Titulo = "Registro de Saída - Revisão dos Dados";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
</div>

<div class="d-flex justify-content-center">
    <form class="col-lg-5 col-xl-4">
        <label class="form-label">Funcionário:</label>
        <input class="form-control mb-2" asp-for="NomeFuncionario" type="text" value="@Model.NomeFuncionario" disabled />

        <label class="form-label">Paciente:</label>
        <input class="form-control mb-2" asp-for="NomePaciente" type="text" value="@Model.NomePaciente" disabled />

        <label class="form-label">Data de Saída:</label>
        <input class="form-control mb-2" asp-for="DataSaida" type="datetime" value="@Model.DataSaida.ToString("dd/MM/yyyy HH:mm:ss")" disabled />

        <label class="form-label">Prescrição:</label>
        <input class="form-control mb-2" asp-for="DescricaoPrescricao" type="text" value="@Model.DescricaoPrescricao" disabled />
    </form>
</div>

<div>
    <div class="d-flex justify-content-center">
        <div class="col-lg-5 col-xl-4">
            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th>Medicamento</th>
                        <th>Dosagem</th>
                        <th>Período</th>
                        <th>Quantidade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DetalhesMedicamentoPrescritoSaidaMedicamentoViewModel p in Model.MedicamentosPrescritos)
                    {
                        <tr>
                            <td class="align-middle">@p.NomeMedicamento</td>
                            <td class="align-middle">@p.Dosagem</td>
                            <td class="align-middle">@p.Periodo</td>
                            <td class="align-middle">@p.Quantidade</td>
                        </tr>
                    }
                </tbody>
            </table>

            <form asp-action="RegistrarSaidaConfirmado"
                  asp-route-idPrescricao="@Model.PrescricaoID"
                  asp-route-idFuncionario="@Model.FuncionarioID"
                  method="post">
                <div class="d-flex justify-content-end">
                    <a class="btn btn-secondary me-2" asp-action="Index">Cancelar</a>
                    <button class="btn btn-success">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>