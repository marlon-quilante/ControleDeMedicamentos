@model GerenciarMedicamentosPrescritosViewModel

@{
    ViewBag.Titulo = "Gerenciamento de Prescrição";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
    <a class="btn btn-close-white btnMenu ms-auto mt-2 mb-2" asp-action="Index">Voltar</a>
</div>

<div class="row container-fluid">
    <div class="col-lg-5 col-xl-4">
        <h4>Informações da Prescrição</h4>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label">Descrição:</label>
            <input class="form-control" asp-for="Descricao" readonly disabled>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CrmMedico" class="form-label">CRM do Médico:</label>
            <input class="form-control" asp-for="CrmMedico" readonly disabled>
            <span asp-validation-for="CrmMedico" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PacienteID" class="form-label">Paciente:</label>
            <input class="form-control" asp-for="Paciente.Nome" readonly disabled>
            <span asp-validation-for="PacienteID" class="text-danger"></span>
        </div>
    </div>

    <div class="col-lg-5 col-xl-4">
        <h4>Adicionar Medicamento</h4>
        <form asp-action="AdicionarMedicamentoPrescrito" asp-route-idPrescricao="@Model.Id" method="post">
            <div class="mb-3">
                <label class="form-label">Medicamento:</label>
                <select class="form-select" name="MedicamentoID" id="MedicamentoID" asp-items="@Model.MedicamentosDisponiveis"></select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="Dosagem">Dosagem:</label>
                <input class="form-control" name="DosagemMedicamento" id="DosagemMedicamento" type="text" placeholder="Dosagem do medicamento (Ex: 10mg)" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="PeriodoMedicamento">Período:</label>
                <input class="form-control" name="PeriodoMedicamento" id="PeriodoMedicamento" type="text" placeholder="Período de consumo" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="QuantidadeMedicamento">Quantidade:</label>
                <input class="form-control" name="QuantidadeMedicamento" id="QuantidadeMedicamento" type="number" placeholder="Quantidade do medicamento" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Adicionar</button>
            </div>
        </form>

        <div class="mt-3">
            <h3 class="mb-3">Medicamentos Selecionados</h3>

            @if (!Model.MedicamentosPrescritos.Any())
            {
                <p class="fw-semibold">Ainda não há nenhum medicamento relacionado à prescrição...</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Medicamento</th>
                            <th>Dosagem</th>
                            <th>Período</th>
                            <th>Quantidade</th>
                            <th>Excluir</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DetalhesMedicamentoPrescritoViewModel mp in Model.MedicamentosPrescritos)
                        {
                            <tr>
                                <td valign="middle">@mp.Medicamento.Nome</td>
                                <td valign="middle">@mp.Dosagem</td>
                                <td valign="middle">@mp.Periodo</td>
                                <td valign="middle">@mp.Quantidade</td>
                                <td>
                                    <form class="my-auto"
                                          asp-action="RemoverMedicamentoPrescrito"
                                          asp-route-idPrescricao="@Model.Id"
                                          asp-route-idMedicamentoPrescrito="@mp.Id">
                                        <button class="btn btn-danger d-flex justify-content-center align-items-center rounded-circle"
                                                style="min-height: 40px">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>