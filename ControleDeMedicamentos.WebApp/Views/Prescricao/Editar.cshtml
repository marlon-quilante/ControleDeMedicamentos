@model EditarPrescricaoViewModel

@{
    ViewBag.Titulo = "Edição de Prescrição Médica";
}

<div class="d-flex container-fluid mb-3" style="background-color: #32376F">
    <h3 class="mt-2 mb-2">@ViewBag.Titulo</h3>
</div>

<div class="d-flex justify-content-center">
    <div class="col-sm-8 col-lg-6 needs-validation">
        <form class="container-fluid mt-3" asp-action="Editar" method="post">
            <div class="mb-3">
                <label class="form-label" asp-for="Descricao">Descrição:</label>
                <input class="form-control" asp-for="Descricao" id="Descricao" type="text" value="@Model.Descricao" placeholder="Descrição da prescrição" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="CrmMedico">CRM do médico:</label>
                <input class="form-control" asp-for="CrmMedico" id="CrmMedico" type="text" value="@Model.CrmMedico" placeholder="CRM do médico (Ex: 1111000-UF)" />
                <span asp-validation-for="CrmMedico" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="DataValidade">Data de Validade:</label>
                <input class="form-control" asp-for="DataValidade" id="DataValidade" type="date" value="@Model.DataValidade.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DataValidade" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="PacienteID">Paciente:</label>
                <select class="form-select" name="PacienteID" asp-for="PacienteID" id="PacienteID" asp-items="@Model.PacientesDisponiveis"></select>
                <span asp-validation-for="PacienteID" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a class="btn btn-secondary" asp-action="Index">Voltar</a>
                <button class="btn btn-success" type="submit">Salvar</button>
            </div>
        </form>
    </div>
</div>